# COMFSCI_DB_NAME=db_comfysci
# COMFSCI_DB_USER=root
# COMFSCI_DB_PASS=

# Assignment Tracker email reminders (SMTP)
COMFSCI_SMTP_HOST=
COMFSCI_SMTP_PORT=587
COMFSCI_SMTP_USERNAME=
COMFSCI_SMTP_PASSWORD=
COMFSCI_SMTP_FROM_EMAIL=
COMFSCI_SMTP_FROM_NAME=ComfSci Assignment Tracker
