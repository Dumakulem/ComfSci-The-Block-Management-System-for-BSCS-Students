# Copy to .env (never commit .env)
GROQ_API_KEY=
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# GROQ_MODEL=openai/gpt-oss-20b

# Database (defaults: 127.0.0.1 / db_comfysci / root / empty)
